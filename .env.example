BACKEND_PORT=4000
FRONTEND_PORT=5173
SYNC_WORKER_COUNT=3
# Comma-separated symbol:interval pairs excluded from automatic sync; manual sync still works.
AUTO_SYNC_EXCLUDE_MARKETS=
TRUST_PROXY=1
# UTC hour when all markets are re-synced daily (default 01:00)
DAILY_SYNC_HOUR_UTC=1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=binance_candles
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Must match BACKEND_PORT (and host if not localhost). Leave empty when frontend is served by the backend.
VITE_API_BASE_URL=

# Admin panel login for /admin-views (not related to hub user accounts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# Optional: scripts may still send X-Admin-Key matching this value
ADMIN_API_KEY=change-this-admin-password
ADMIN_COOKIE_NAME=binance_admin_session
ADMIN_SESSION_HOURS=12

# Optional: full URL overrides DB_* when set
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/binance_candles

JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7
# Shared account store. Use a dedicated DB role with access only to the identity tables.
HUB_DATABASE_URL=postgresql://identity_app:replace-me@127.0.0.1:5432/social_dataset
# Must match the shared account signing secret on all services.
AUTH_JWT_SECRET=change-this-session-secret
AUTH_COOKIE_NAME=ww_access_token
AUTH_JWT_EXPIRE_DAYS=7
APP_BASE_URL=http://127.0.0.1:4000
# Internal only — used for invite links and default project bootstrap
DEFAULT_PROJECT_SLUG=binance
